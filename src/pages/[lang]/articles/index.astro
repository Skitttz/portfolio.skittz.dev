---
import '@/styles/article-index.css';
import LangToggle from '@/components/astro/LangToggle.astro';
import NotFoundArticle from '@/components/astro/NotFoundArticle.astro';
import { formatDate } from '@/utils/format-date';
import { getHrefLang } from '@/utils/get-href-lang.ts';
import Footer from '@components/astro/Footer.astro';
import SnowfallToggle from '@components/astro/SnowfallToggle.astro';
import ThemeToggle from '@components/astro/ThemeToggle.astro';
import Layout from '@layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

const lang = Astro.params.lang ?? 'pt-br';

const indexCopy = {
  en: {
    homeLabel: 'Back home',
    homeText: 'Home',
    navigationLabel: 'Main navigation',
    heading: 'Articles',
    readLabel: 'Read',
    emptyHint: 'No entries yet. New write-ups coming soon.',
  },
  'pt-br': {
    homeLabel: 'Voltar para home',
    homeText: 'Início',
    navigationLabel: 'Navegação principal',
    heading: 'Artigos',
    readLabel: 'Ler',
    emptyHint: 'Ainda sem entradas. Novos textos em breve.',
  },
};

const posts = (await getCollection('articles')).filter(
  (post) => post.data.lang === lang,
);

const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const ui =
  indexCopy[lang as keyof typeof indexCopy] || indexCopy.en;
const pageMetadata = {
  lang,
  title: lang === 'pt-br' ? 'Artigos | Carlos Vinicius' : 'Articles | Carlos Vinicius',
  description: lang === 'pt-br'
    ? 'Artigos sobre desenvolvimento front-end, tecnologia e projetos de Carlos Vinicius.'
    : 'Articles about front-end development, technology, and projects by Carlos Vinicius.',
  canonical: `https://portfolio.skittz.dev/${lang}/articles`,
};
---

<Layout {...pageMetadata}>
  <div class="fixed top-6 right-36 z-[9999]">
    <LangToggle lang={lang} />
  </div>

  <div class="fixed top-6 right-20 z-[9999]">
    <ThemeToggle />
  </div>

  <div class="fixed top-6 right-6 z-[9999]">
    <SnowfallToggle />
  </div>

  <div class="article-index">
    <div class="hero-background" aria-hidden="true">
      <div
        class="hero-grid"
        style="background-image: radial-gradient(circle at 1px 1px, rgba(100,116,139,0.42) 1px, transparent 0); background-size: 22px 22px;"
      ></div>
    </div>

    <nav class="article-index-nav" aria-label={ui.navigationLabel}>
      <a class="article-index-home" href={getHrefLang(lang)} aria-label={ui.homeLabel}>
        <Icon name="mdi:arrow-left" aria-hidden="true" />
        <span>{ui.homeText}</span>
      </a>
    </nav>

    <main class="article-index-main">
      <div class="article-index-shell">
        <h1 class="sr-only">{ui.heading}</h1>

        {sortedPosts.length > 0 ? (
          <ul class="article-index-list">
            {sortedPosts.map((post, index) => (
              <li>
                <article aria-labelledby={`article-title-${index}`}>
                  <a
                    class="article-node"
                    href={`/${post.data.lang}/articles/${post.id}`}
                    aria-labelledby={`article-title-${index}`}
                  >
                    <div class="article-index-content">
                      <time datetime={post.data.date.toISOString()}>
                        {formatDate(new Date(post.data.date), lang)}
                      </time>
                      <h2 class="article-index-title" id={`article-title-${index}`}>
                        {post.data.title}
                      </h2>
                      {post.data.description && (
                        <p class="article-index-description">{post.data.description}</p>
                      )}
                    </div>
                    <span class="article-index-action" aria-hidden="true">
                      <span>{ui.readLabel}</span>
                      <Icon name="mdi:arrow-right" />
                    </span>
                  </a>
                </article>
              </li>
            ))}
          </ul>
        ) : (
          <div class="article-index-empty">
            <p>{ui.emptyHint}</p>
            <NotFoundArticle lang={lang} />
          </div>
        )}
      </div>
    </main>
    <Footer lang={lang} />
  </div>
</Layout>
