---
const acceptedLanguages = Astro.request.headers.get('accept-language')?.toLowerCase() ?? '';
const preferredLanguage = acceptedLanguages
  .split(',')
  .map((entry) => {
    const [language, quality = 'q=1'] = entry.trim().split(';');
    return { language, quality: Number(quality.replace(/^q=/, '')) || 0 };
  })
  .sort((first, second) => second.quality - first.quality)
  .find(({ language, quality }) => quality > 0 && (language.startsWith('pt') || language.startsWith('en')))
  ?.language;
const lang = preferredLanguage?.startsWith('pt') ? 'pt-br' : 'en';

Astro.response.headers.set('Vary', 'Accept-Language');
return Astro.redirect(`/${lang}`, 302);
