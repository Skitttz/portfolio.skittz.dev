---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SnowfallController } from '@/components/react/SnowfallController';

export interface Props {
  title: string;
  lang: string;
  description?: string;
  canonical?: string;
}

const { title, lang, description = "Carlos Vinicius — front-end developer building accessible, maintainable web products.", canonical } = Astro.props;
const alternatePt = canonical?.replace(/\/(?:pt-br|en)(?=\/|$)/, "/pt-br");
const alternateEn = canonical?.replace(/\/(?:pt-br|en)(?=\/|$)/, "/en");
---

<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline>
      const theme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia(
        '(prefers-color-scheme: dark)',
      ).matches;
      const isDark = theme === 'dark' || (!theme && prefersDark);

      if (isDark) {
        document.documentElement.classList.add('dark');
      }
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === "pt-br" ? "pt_BR" : "en_US"} />
    <meta name="twitter:card" content="summary" />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternatePt && <link rel="alternate" hreflang="pt-BR" href={alternatePt} />}
    {alternateEn && <link rel="alternate" hreflang="en" href={alternateEn} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Roboto:ital,wght@0,400;0,500;0,700;1,400;1,500;1,700&display=swap"
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>

  <body style={{ position: 'relative' }}>
    <SnowfallController client:only="react" />
    <slot />
  </body>
</html>

<ClientRouter />

<script>
  const syncTheme = (root: HTMLElement) => {
    const theme = localStorage.getItem('theme');
    const prefersDark = window.matchMedia(
      '(prefers-color-scheme: dark)',
    ).matches;
    const isDark = theme === 'dark' || (!theme && prefersDark);

    root.classList.toggle('dark', isDark);
  };

  document.addEventListener('astro:before-swap', (event) => {
    const newDocument = (event as CustomEvent<{ newDocument: Document }>).detail.newDocument;
    syncTheme(newDocument.documentElement);
  });

  document.addEventListener('astro:after-swap', () => {
    syncTheme(document.documentElement);
  });
</script>

<script>
  const projectNavigationWindow = window as Window & { __projectNavigationReady?: boolean };
  if (!projectNavigationWindow.__projectNavigationReady) {
    projectNavigationWindow.__projectNavigationReady = true;

    const restoreProjectsPosition = () => {
      if (window.location.hash !== '#projects') return;
      const projects = document.getElementById('projects');
      if (!projects) return;
      requestAnimationFrame(() => {
        projects.scrollIntoView({ behavior: 'auto', block: 'start' });
        history.replaceState(
          { ...history.state, scrollX: window.scrollX, scrollY: window.scrollY },
          '',
          window.location.pathname + window.location.search,
        );
      });
    };

    document.addEventListener('astro:page-load', restoreProjectsPosition);
    window.addEventListener('pageshow', restoreProjectsPosition);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', restoreProjectsPosition, { once: true });
    else restoreProjectsPosition();
  }
</script>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    background: rgb(248, 250, 252);
  }

  html {
    color-scheme: dark light;
  }

  html.dark body {
    background: rgb(15, 23, 42);
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }
</style>
