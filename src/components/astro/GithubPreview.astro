---
import { Icon } from "astro-icon/components";
import { projectContent, projectPath } from "@/constants/projects";
import en from "@locales/en.json";
import pt from "@locales/pt-br.json";

export interface Props { lang: string; }

const { lang } = Astro.props;
const isPt = lang === "pt-br";
const translations = isPt ? pt : en;
const content = projectContent[isPt ? "pt-br" : "en"];
const selected = ["athow", "passai", "cats"].map((slug) =>
  [...content.projects, ...content.otherProjects].find((project) => project.slug === slug)!,
);
const icons: Record<string, string> = {
  athow: "mdi:finance",
  passai: "mdi:file-send-outline",
  cats: "mdi:cat",
};
---

<div class="preview-shell">
  <button class="preview-trigger" type="button" aria-label={isPt ? "Explorar três demos selecionadas" : "Explore three selected demos"} aria-haspopup="dialog" data-demo-trigger>
    <img src="https://github.com/skitttz.png" alt="" width="80" height="80" />
  </button>
  <span class="preview-hint preview-hint--desktop">{translations.githubPreview.actionText}</span>
  <span class="preview-hint preview-hint--mobile">{translations.githubPreview.actionTextMobile}</span>

  <div class="preview-panel" aria-label={isPt ? "Demos selecionadas" : "Selected demos"}>
    <div class="preview-panel-head"><span>01 — 03</span><strong>{isPt ? "Abra o produto ou leia o projeto" : "Open the product or read the project"}</strong></div>
    {selected.map((project) => (
      <div class="preview-item">
        <span class="preview-icon"><Icon name={icons[project.slug]} aria-hidden="true" /></span>
        <div class="preview-item-body"><strong>{project.name}</strong><p>{project.summary}</p>{project.slug === "athow" && <small>{isPt ? "App com login" : "Sign-in required"}</small>}<div class="preview-links"><a class="preview-link preview-link--primary" href={projectPath(lang, project.slug)}>{content.caseLabel} →</a><a class="preview-link preview-link--secondary" href={project.live} target="_blank" rel="noopener noreferrer">{content.demoLabel} ↗</a></div></div>
      </div>
    ))}
    <button class="preview-all" type="button" data-scroll-projects>{isPt ? "Ver todos os projetos" : "View all projects"} →</button>
  </div>

  <dialog class="preview-dialog" data-demo-dialog aria-label={isPt ? "Demos selecionadas" : "Selected demos"}>
    <div class="preview-dialog-head"><strong>{isPt ? "Projetos para explorar" : "Projects to explore"}</strong><button type="button" data-demo-close aria-label={isPt ? "Fechar" : "Close"}><Icon name="mdi:close" aria-hidden="true" /></button></div>
    {selected.map((project) => (
      <div class="preview-item">
        <span class="preview-icon"><Icon name={icons[project.slug]} aria-hidden="true" /></span>
        <div class="preview-item-body"><strong>{project.name}</strong><p>{project.summary}</p>{project.slug === "athow" && <small>{isPt ? "App com login" : "Sign-in required"}</small>}<div class="preview-links"><a class="preview-link preview-link--primary" href={projectPath(lang, project.slug)}>{content.caseLabel} →</a><a class="preview-link preview-link--secondary" href={project.live} target="_blank" rel="noopener noreferrer">{content.demoLabel} ↗</a></div></div>
      </div>
    ))}
    <button class="preview-all" type="button" data-scroll-projects>{isPt ? "Ver todos os projetos" : "View all projects"} →</button>
  </dialog>
</div>

<script>
  const setupDemoPreview = () => {
    document.querySelectorAll<HTMLElement>(".preview-shell").forEach((shell) => {
      if (shell.dataset.ready) return;
      shell.dataset.ready = "true";
      const trigger = shell.querySelector<HTMLButtonElement>("[data-demo-trigger]");
      const dialog = shell.querySelector<HTMLDialogElement>("[data-demo-dialog]");
      const close = shell.querySelector<HTMLButtonElement>("[data-demo-close]");
      trigger?.addEventListener("click", () => {
        if (window.matchMedia("(hover: none), (max-width: 767px)").matches) dialog?.showModal();
      });
      close?.addEventListener("click", () => { dialog?.close(); trigger?.focus(); });
      dialog?.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
      shell.querySelectorAll<HTMLButtonElement>("[data-scroll-projects]").forEach((button) => {
        button.addEventListener("click", () => {
          if (dialog?.open) dialog.close();
          document.getElementById("projects")?.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });
    });
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", setupDemoPreview, { once: true });
  else setupDemoPreview();
  document.addEventListener("astro:after-swap", setupDemoPreview);
</script>

<style>
  .preview-shell { position: relative; z-index: 60; display: inline-grid; place-items: center; flex: none; }
  .preview-trigger { display: grid; width: 6rem; height: 6rem; place-items: center; padding: .45rem; border: 1px solid #d7dee7; border-radius: 1rem; background: #fff; box-shadow: 0 12px 28px rgba(15,23,42,.13); cursor: pointer; transition: transform .2s, box-shadow .2s; }
  .preview-trigger:hover, .preview-trigger:focus-visible { transform: translateY(-3px); box-shadow: 0 18px 36px rgba(15,23,42,.18); }
  .preview-trigger img { width: 100%; height: 100%; object-fit: cover; border-radius: .65rem; }
  :global(.dark) .preview-trigger { border-color: #334155; background: #0f172a; }
  .preview-hint { position: absolute; bottom: calc(100% + .5rem); left: 50%; transform: translateX(-50%); white-space: nowrap; padding: .45rem .7rem; border-radius: 99px; background: #1f2937; color: #fff; box-shadow: 0 5px 16px rgba(0,0,0,.14); font-size: .67rem; font-weight: 600; pointer-events: none; }
  .preview-hint--mobile { display: none; }
  .preview-shell:hover .preview-hint, .preview-shell:focus-within .preview-hint { opacity: 0; }
  .preview-panel { position: absolute; top: calc(100% + 1rem); left: 50%; z-index: 80; width: min(23rem, calc(100vw - 2rem)); transform: translate(-50%, -.4rem); padding: 1rem; border: 1px solid #dbe3e7; border-radius: 1rem; background: #fff; box-shadow: 0 24px 60px rgba(15,23,42,.24); color: #152b34; text-align: left; opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .2s, transform .2s, visibility .2s; }
  .preview-panel::before { content: ""; position: absolute; bottom: 100%; left: 0; right: 0; height: 1rem; }
  .preview-shell:hover .preview-panel, .preview-shell:focus-within .preview-panel { opacity: 1; visibility: visible; pointer-events: auto; transform: translate(-50%, 0); }
  :global(.dark) .preview-panel { border-color: #334155; background: #111f2b; color: #edf6f4; }
  .preview-panel-head { display: flex; justify-content: space-between; align-items: baseline; gap: .75rem; margin-bottom: .65rem; color: #657882; font: 600 .65rem var(--font-mono); }
  .preview-panel-head strong { color: inherit; font-size: .62rem; font-weight: 600; }
  .preview-item { display: flex; align-items: start; gap: .75rem; padding: .85rem 0; border-top: 1px solid rgba(148,163,184,.2); }
  .preview-icon { display: grid; flex: none; width: 2rem; height: 2rem; place-items: center; border-radius: .55rem; background: #ddf5ec; color: #186a60; }
  .preview-icon :global(svg) { width: 1.15rem; height: 1.15rem; }
  :global(.dark) .preview-icon { background: #173c3b; color: #8de3c8; }
  .preview-item-body { min-width: 0; }
  .preview-item-body strong { display: block; font-size: .89rem; }
  .preview-item-body p { margin: .25rem 0 .55rem; color: #647985; font-size: .73rem; line-height: 1.45; }
  .preview-item-body small { display: block; margin: -.2rem 0 .5rem; color: #71858f; font: 600 .64rem var(--font-mono); }
  :global(.dark) .preview-item-body p { color: #a9bdc7; }
  .preview-links { display: flex; flex-wrap: wrap; gap: .4rem; }
  .preview-link { display: inline-flex; align-items: center; min-height: 2rem; padding: .3rem .6rem; border: 1px solid #b8d8d0; border-radius: .45rem; font-size: .68rem; font-weight: 700; line-height: 1.2; text-decoration: none; }
  .preview-link--primary { border-color: #16695f; background: #16695f; color: #fff; }
  .preview-link--primary:hover { background: #0e5149; }
  .preview-link--secondary { color: #16695f; }
  .preview-link--secondary:hover { border-color: #16695f; background: #eef9f5; }
  :global(.dark) .preview-link--primary { border-color: #92efd2; background: #92efd2; color: #071b1b; }
  :global(.dark) .preview-link--primary:hover { background: #bbffe8; }
  :global(.dark) .preview-link--secondary { border-color: #527970; color: #a9f2da; }
  :global(.dark) .preview-link--secondary:hover { background: #213b3b; }
  .preview-all { display: inline-block; margin-top: .7rem; padding: 0; border: 0; background: none; color: #137567; font-size: .7rem; font-weight: 700; text-decoration: underline; text-underline-offset: .2rem; cursor: pointer; }
  .preview-all:hover { color: #0a5149; }
  :global(.dark) .preview-all { color: #92efd2; }
  :global(.dark) .preview-all:hover { color: #fff; }
  .preview-dialog { width: min(26rem, calc(100vw - 2rem)); max-height: min(82dvh, 38rem); overflow: auto; padding: 1.2rem; border: 1px solid #dbe3e7; border-radius: 1rem; background: #fff; color: #152b34; box-shadow: 0 30px 80px rgba(0,0,0,.35); text-align: left; }
  .preview-dialog::backdrop { background: rgba(5,15,25,.65); backdrop-filter: blur(4px); }
  .preview-dialog-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: .35rem; font-size: 1.1rem; }
  .preview-dialog-head button { display: grid; width: 2rem; height: 2rem; place-items: center; border: 0; border-radius: .4rem; background: #edf2f2; cursor: pointer; }
  .preview-dialog-head :global(svg) { width: 1.1rem; height: 1.1rem; }
  :global(.dark) .preview-dialog { border-color: #334155; background: #111f2b; color: #edf6f4; }
  :global(.dark) .preview-dialog-head button { background: #263b45; color: #edf6f4; }
  @media (max-width: 767px), (hover: none) { .preview-panel { display: none; } .preview-hint { font-size: .62rem; } .preview-hint--desktop { display: none; } .preview-hint--mobile { display: block; } }
  @media (prefers-reduced-motion: reduce) { .preview-trigger, .preview-panel { transition: none; } }
</style>
