---
import { projectContent, projectPath } from "@/constants/projects";

export interface Props { lang: string }
const { lang } = Astro.props;
const isPt = lang === "pt-br";
const content = projectContent[isPt ? "pt-br" : "en"];
const projects = [...content.projects, ...content.otherProjects];
const closeLabel = isPt ? "Voltar ao terminal" : "Back to terminal";
---

<dialog class="terminal-panel" data-terminal-panel aria-labelledby="terminal-projects-title">
  <header class="panel-bar">
    <span data-terminal-panel-path>~/portfolio/projects</span>
    <button type="button" data-terminal-panel-close aria-label={closeLabel} autofocus>
      <kbd>esc</kbd><span>{isPt ? "voltar" : "back"}</span>
    </button>
  </header>
  <div class="panel-scroll" data-terminal-panel-scroll>
    <section data-terminal-section="projects">
      <div class="panel-intro">
        <p class="panel-eyebrow">{isPt ? "Projetos" : "Projects"} / {String(projects.length).padStart(2, "0")}</p>
        <h2 id="terminal-projects-title">{content.title}</h2>
        <p>{content.intro}</p>
      </div>
      <div class="panel-projects">
        {projects.map((project, index) => (
          <article class="panel-card" aria-labelledby={`terminal-project-${project.slug}`}>
            <div class="card-heading">
              <span class="card-index">{String(index + 1).padStart(2, "0")}</span>
              <span class="card-category">{project.category}</span>
            </div>
            <h3 id={`terminal-project-${project.slug}`}>{project.name}</h3>
            <p>{project.summary}</p>
            <ul class="card-stack" aria-label={isPt ? "Tecnologias" : "Technologies"}>
              {project.stack.map((technology) => <li>{technology}</li>)}
            </ul>
            <div class="card-links">
              <a href={projectPath(lang, project.slug)} target="_blank" rel="noopener noreferrer">{content.caseLabel}<span aria-hidden="true"> ↗</span></a>
              {project.href && <a href={project.href} target="_blank" rel="noopener noreferrer">{content.sourceLabel}<span aria-hidden="true"> ↗</span></a>}
              {project.live && !project.livePaused && <a href={project.live} target="_blank" rel="noopener noreferrer">{content.demoLabel}<span aria-hidden="true"> ↗</span></a>}
              {project.livePaused && <span class="card-note">{content.pausedLabel}</span>}
            </div>
          </article>
        ))}
      </div>
    </section>
    <section data-terminal-section="experience" hidden>
      <div class="panel-intro">
        <p class="panel-eyebrow">{isPt ? "Experiência" : "Experience"}</p>
        <h2 id="terminal-experience-title">{content.experienceTitle}</h2>
        <p>{content.experienceIntro}</p>
      </div>
      <ol class="panel-timeline">
        {content.experience.map((job, index) => (
          <li>
            <p class="job-period"><span class="job-dot" data-current={index === 0 ? "true" : undefined} aria-hidden="true"></span>{job.period}</p>
            <article class="panel-card">
              <p class="job-company">{job.company}</p>
              <h3>{job.role}</h3>
              <p class="job-location">{job.location}</p>
              <p>{job.description}</p>
              <ul class="job-contributions">{job.contributions.map((contribution) => <li>{contribution}</li>)}</ul>
              {job.impact && <p class="job-impact"><strong>{job.impact}</strong> {job.impactLabel}</p>}
              <p class="job-stack">{job.stack}</p>
            </article>
          </li>
        ))}
      </ol>
    </section>
  </div>
</dialog>

<style>
  .terminal-panel {
    width: min(58rem, calc(100vw - 2rem));
    height: min(42rem, calc(100dvh - 3rem));
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--terminal-border);
    border-radius: 1rem;
    background: var(--terminal-bg);
    color: var(--terminal-text);
    box-shadow: 0 1.5rem 5rem rgb(0 0 0 / 0.3);
    font-family: "Inter", sans-serif;
  }
  .terminal-panel[open] {
    display: flex;
    flex-direction: column;
    animation: panel-in 0.18s ease-out;
  }
  .terminal-panel::backdrop {
    background: color-mix(in srgb, var(--terminal-bg) 65%, transparent);
    backdrop-filter: blur(4px);
  }
  @keyframes panel-in {
    from { opacity: 0; transform: translateY(0.6rem) scale(0.98); }
    to { opacity: 1; transform: none; }
  }
  .panel-bar {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    border-bottom: 1px solid var(--terminal-border);
    background: var(--terminal-bar-bg);
    color: var(--terminal-muted);
    font: 0.8rem/1.5 var(--font-mono);
  }
  .panel-bar button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem;
    border: 0;
    border-radius: 0.4rem;
    background: none;
    color: var(--terminal-text);
    font: inherit;
    cursor: pointer;
  }
  .panel-bar kbd { font: inherit; text-transform: uppercase; }
  .panel-bar button:hover { background: var(--terminal-surface); }
  .panel-scroll {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(1rem, 3vw, 2rem);
  }
  .panel-intro { margin-bottom: 1.5rem; max-width: 40rem; }
  .panel-eyebrow { color: var(--terminal-green); font: 0.75rem/1.6 var(--font-mono); }
  h2 { margin: 0.4rem 0 0.75rem; font-size: clamp(1.6rem, 3vw, 2rem); line-height: 1.2; letter-spacing: -0.03em; }
  p { margin: 0; font-size: 0.9rem; line-height: 1.65; }
  .panel-intro > p:last-child, .panel-card > p { color: var(--terminal-muted); }
  .panel-projects { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .panel-card {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid var(--terminal-border);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--terminal-surface) 35%, var(--terminal-bg));
    overflow-wrap: anywhere;
  }
  .card-heading { display: flex; align-items: baseline; gap: 0.8rem; font: 0.7rem/1.5 var(--font-mono); }
  .card-index { color: var(--terminal-green); }
  .card-category { color: var(--terminal-muted); }
  h3 { margin: 0; font-size: 1.25rem; line-height: 1.4; font-weight: 600; }
  .card-stack { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.25rem 0; padding: 0; list-style: none; }
  .card-stack li { padding: 0.25rem 0.5rem; border-radius: 0.3rem; background: var(--terminal-surface); color: var(--terminal-text); font: 0.7rem/1.4 var(--font-mono); }
  .card-links { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin-top: auto; }
  .card-links a { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--terminal-blue); font-size: 0.8rem; text-decoration: underline; text-underline-offset: 0.2em; }
  .card-note { align-self: center; color: var(--terminal-muted); font-size: 0.75rem; }
  .panel-timeline { display: grid; gap: 1.5rem; padding: 0; margin: 0; list-style: none; }
  .job-period { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.65rem; color: var(--terminal-muted); font: 0.75rem/1.5 var(--font-mono); }
  .job-dot { width: 0.4rem; height: 0.4rem; border-radius: 50%; background: var(--terminal-muted); }
  .job-dot[data-current] { background: var(--terminal-green); }
  .panel-card .job-company { color: var(--terminal-green); font: 0.8rem/1.5 var(--font-mono); }
  .panel-card .job-location { font-size: 0.8rem; }
  .job-contributions { display: grid; gap: 0.5rem; margin: 0; padding-left: 1.1rem; color: var(--terminal-muted); font-size: 0.85rem; line-height: 1.65; list-style: disc; }
  .job-impact strong { color: var(--terminal-text); font-size: 1.15rem; }
  .panel-card .job-stack { color: var(--terminal-cyan); font: 0.75rem/1.6 var(--font-mono); }
  button:focus-visible, a:focus-visible { outline: 2px solid var(--terminal-green); outline-offset: 3px; }
  @media (max-width: 640px) {
    .panel-projects { grid-template-columns: minmax(0, 1fr); }
    .panel-bar { padding-inline: 0.75rem; font-size: 0.65rem; }
    .panel-card { padding: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .terminal-panel[open] { animation: none; }
    .terminal-panel::backdrop { backdrop-filter: none; }
  }
</style>
