---
import "@/styles/hero.css";
import AboutPreview from "@components/astro/AboutPreview.astro";
import Button from "@components/astro/Button.astro";
import DynamicText from "@components/astro/DynamicText.astro";
import StatusIndicator from "@components/astro/StatusIndicator.astro";
import TerminalToggle from "@components/astro/TerminalToggle.astro";
import ThemeToggle from "@components/astro/ThemeToggle.astro";
import LangToggle from "./LangToggle.astro";
import SnowfallToggle from "./SnowfallToggle.astro";

export interface Props {
  lang: string;
  button: {
    textPrimary: string;
    textSecondary: string;
  };
  textIntro: string;
  selfProfissionalText: string;
  name: string;
  tagline: string;
  nickname: string;
  fileName: string;
  linkedInText: string;
}

const {
  button: { textPrimary, textSecondary },
  textIntro,
  selfProfissionalText,
  name,
  tagline,
  nickname,
  fileName,
  linkedInText,
  lang,
} = Astro.props;

const textsProfissional = {
  en: ["Front-End Developer.", "Software Engineer.", "UI Developer."],
  "pt-br": [
    "Desenvolvedor Front-End.",
    "Engenheiro de Software.",
    "Desenvolvedor de UI.",
  ],
};

const textsToDynamicText: string[] =
  textsProfissional[lang as keyof typeof textsProfissional] ||
  textsProfissional.en;
const articlesMobileText = textSecondary.replace(/\s+posts$/i, "");
const projectsCueText =
  lang === "pt-br"
    ? "explorar projetos"
    : "explore projects";
---

<div class="fixed top-6 right-6 z-[9999] flex items-center gap-4">
  <LangToggle lang={lang} />
  <ThemeToggle />
  <TerminalToggle lang={lang} />
  <SnowfallToggle />
</div>
<div class="flex flex-col min-h-[100dvh] pt-20 sm:pt-0 relative main-header">
  <div class="hero-background absolute inset-0">
    <div
      class="hero-grid absolute inset-0"
      style="background-image: radial-gradient(circle at 1px 1px, rgba(100,116,139,0.42) 1px, transparent 0); background-size: 22px 22px;"
    >
    </div>
  </div>

  <main
    class="relative z-50 flex items-center justify-center px-6 py-8 md:py-10 flex-grow"
  >
    <div class="relative z-50 max-w-3xl mx-auto w-full" data-immersive-hero>
      <section class="space-y-6 text-center animate-fadeInUp">
        <div class="space-y-3">
          <div class="flex gap-2 items-center justify-center flex-wrap">
            <h1
              class="contents text-2xl md:text-4xl font-semibold text-gray-900 dark:text-slate-100"
            >
              <span>{textIntro}</span>{" "}
              <span class="order-1">{name}</span>
            </h1>
            <AboutPreview lang={lang} />
          </div>

          <p
            class="text-base text-gray-600 dark:text-slate-400 max-w-xl mx-auto"
          >
            {tagline}
          </p>
          <h2
            class="font-mono text-gray-950 dark:text-slate-50 font-semibold text-5xl md:text-6xl mt-1 tracking-tight"
          >
            {nickname}.
          </h2>
        </div>

        <div class="flex items-center justify-center space-x-2 text-lg">
          <span class="text-gray-600 dark:text-slate-400"
            >{selfProfissionalText} {" "}
            <DynamicText texts={textsToDynamicText} /></span
          >
        </div>
        <div class="flex justify-center">
          <div
            class="bg-white/80 dark:bg-slate-900/80 text-gray-900 dark:text-white rounded-xl px-5 py-3 shadow-lg max-w-sm border border-gray-200/80 dark:border-slate-700/80 backdrop-blur-sm"
          >
            <div class="flex items-center space-x-3">
              <div class="text-left flex flex-col gap-2 justify-center">
                <div class="font-semibold text-sm"><StatusIndicator /></div>
                <div class="text-xs text-gray-600 dark:text-slate-400">
                  {linkedInText}{" "}
                  <a
                    target="_blank"
                    href="https://linkedin.com/in/carlos-vinicius-dev"
                    rel="noopener noreferrer"
                    aria-label="LinkedIn"
                    class="text-gray-900 dark:text-slate-100 underline"
                    >Linkedin</a
                  >.
                </div>
              </div>
            </div>
          </div>
        </div>

        <div
          class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4"
        >
          <Button
            href={`/${fileName}.pdf`}
            text={textPrimary}
            download={true}
            customClassName="min-w-[152px]"
          />
          <Button
            href={`/${lang}/articles`}
            text={textSecondary}
            mobileText={articlesMobileText}
            variant="blog"
            customClassName="w-[152px] sm:w-auto"
          />
        </div>

        <button
          type="button"
          data-scroll-projects
          class="terminal-cue mt-1 inline-flex items-center gap-2 rounded-full border border-slate-300/70 bg-white/55 px-3 py-2 font-mono text-xs text-slate-600 shadow-sm backdrop-blur-sm transition-colors hover:border-emerald-500/50 hover:text-emerald-700 dark:border-slate-700/70 dark:bg-slate-950/35 dark:text-slate-400 dark:hover:border-emerald-400/50 dark:hover:text-emerald-300 sm:hidden"
        >
          <span aria-hidden="true">$</span>
          <span>{projectsCueText}</span>
          <span class="terminal-cue-mark" aria-hidden="true"></span>
        </button>
      </section>
    </div>

    <button
      type="button"
      data-scroll-projects
      class="terminal-cue absolute bottom-5 left-1/2 z-10 hidden -translate-x-1/2 items-center gap-2 rounded-full border border-slate-300/70 bg-white/55 px-3 py-2 font-mono text-xs text-slate-600 shadow-sm backdrop-blur-sm transition-colors hover:border-emerald-500/50 hover:text-emerald-700 dark:border-slate-700/70 dark:bg-slate-950/35 dark:text-slate-400 dark:hover:border-emerald-400/50 dark:hover:text-emerald-300 sm:inline-flex"
    >
      <span aria-hidden="true">$</span>
      <span>{projectsCueText}</span>
      <span class="terminal-cue-mark" aria-hidden="true"></span>
    </button>
  </main>
</div>

<script>
  const initProjectScrollCue = () => {
    document.querySelectorAll<HTMLButtonElement>("[data-scroll-projects]").forEach((button) => {
      if (button.dataset.bound === "true") return;
      button.dataset.bound = "true";

      button.addEventListener("click", () => {
        document.querySelector("#projects")?.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      });
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProjectScrollCue);
  } else {
    initProjectScrollCue();
  }

  document.addEventListener("astro:after-swap", initProjectScrollCue);
</script>
