---
import { getCollection } from "astro:content";
import { buildTerminalContent } from "@/terminal/content";
import { projectContent } from "@/constants/projects";
import en from "@locales/en.json";
import pt from "@locales/pt-br.json";

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const isPt = lang === "pt-br";
const locale = isPt ? pt : en;
const posts = (await getCollection("articles"))
  .filter((post) => post.data.lang === (isPt ? "pt-br" : "en"))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const projectList = projectContent[isPt ? "pt-br" : "en"];
const git = {
  branch: import.meta.env.VERCEL_GIT_COMMIT_REF || "main",
  commit: import.meta.env.VERCEL_GIT_COMMIT_SHA?.slice(0, 7),
};
const content = buildTerminalContent({
  projects: projectList.projects.length + projectList.otherProjects.length,
  git,
  now: new Date(),
  lang: isPt ? "pt-br" : "en",
  nickname: locale.nickname,
  location: locale.about.location,
  cvFile: locale.fileName,
  articles: posts.map((post) => ({
    title: post.data.title,
    href: `/${post.data.lang}/articles/${post.id}`,
  })),
});
const ui = isPt
  ? { label: "Modo terminal", exit: "sair", exitLabel: "Sair do modo terminal", input: "Comando" }
  : { label: "Terminal mode", exit: "exit", exitLabel: "Leave terminal mode", input: "Command" };
---

<dialog
  class="terminal-mode"
  aria-label={ui.label}
  data-colors="default"
  data-terminal-mode
  data-terminal-content={JSON.stringify(content)}
>
  <header class="terminal-bar">
    <strong>~/portfolio</strong>
    <button type="button" aria-label={ui.exitLabel} data-terminal-close>
      <kbd>esc</kbd>
      <span>{ui.exit}</span>
    </button>
  </header>

  <div class="terminal-screen" data-terminal-screen>
    <div class="terminal-output" role="log" data-terminal-output></div>

    <form class="terminal-prompt" data-terminal-form data-result="success">
      <div class="terminal-prompt-top" aria-hidden="true">
        <span class="terminal-directory">~/portfolio</span>
        <span class="terminal-git">
          <span class="terminal-on">on</span>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="4" cy="3" r="2"/><circle cx="12" cy="4" r="2"/><circle cx="4" cy="13" r="2"/><path d="M4 5v6m8-5c0 4-8 1-8 5"/></svg>
          <span class="terminal-branch" title={git.branch}>{git.branch}</span>
          {git.commit && <span class="terminal-commit">@ {git.commit}</span>}
        </span>
        <time data-terminal-time></time>
      </div>
      <div class="terminal-prompt-bottom">
        <label for="terminal-input">
          <span class="terminal-arrow" aria-hidden="true">$</span>
          <span class="sr-only">{ui.input}</span>
        </label>
        <div class="terminal-input-wrap">
          <div class="terminal-highlight" aria-hidden="true" data-terminal-highlight></div>
          <input
            id="terminal-input"
            type="text"
            autocomplete="off"
            autocapitalize="none"
            autocorrect="off"
            spellcheck="false"
            enterkeyhint="send"
            autofocus
            data-terminal-input
          />
        </div>
      </div>
    </form>
  </div>
</dialog>

<script>
  import { colorSchemes, complete, createHistory, highlight, runCommand, suggest } from "@/terminal/shell";
  import type { ColorScheme, Effect, Line, ShellContent } from "@/terminal/shell";
  import { isSnowing, setSnow } from "@/utils/snowfall";
  import { switchLang } from "@/utils/switch-lang";
  import { getTheme, setTheme } from "@/utils/theme";

  const REOPEN_KEY = "terminal-mode";
  const COLORS_KEY = "terminal-colors";
  const recall = createHistory();

  const initTerminalMode = () => {
    const dialog = document.querySelector<HTMLDialogElement>("[data-terminal-mode]");
    if (!dialog || dialog.dataset.ready) return;
    dialog.dataset.ready = "true";

    const content: ShellContent = JSON.parse(dialog.dataset.terminalContent!);
    const screen = dialog.querySelector<HTMLElement>("[data-terminal-screen]")!;
    const output = dialog.querySelector<HTMLElement>("[data-terminal-output]")!;
    const form = dialog.querySelector<HTMLFormElement>("[data-terminal-form]")!;
    const input = dialog.querySelector<HTMLInputElement>("[data-terminal-input]")!;
    const closeButton = dialog.querySelector<HTMLButtonElement>("[data-terminal-close]")!;
    const openers = document.querySelectorAll<HTMLButtonElement>("[data-terminal-open]");
    const ink = dialog.querySelector<HTMLElement>("[data-terminal-highlight]")!;
    const time = dialog.querySelector<HTMLTimeElement>("[data-terminal-time]")!;
    let focusOpenerOnClose = true;
    let suggestion = "";

    const updateTime = () => {
      const now = new Date();
      time.textContent = `${String(now.getHours()).padStart(2, "0")}:${String(now.getMinutes()).padStart(2, "0")}`;
      time.dateTime = now.toISOString();
    };

    const syncInk = () => {
      ink.replaceChildren();
      for (const part of highlight(input.value)) {
        const span = document.createElement("span");
        span.textContent = part.text;
        span.dataset.highlight = part.type;
        ink.append(span);
      }
      suggestion = suggest(input.value, recall.find(input.value));
      if (suggestion) {
        const ghost = document.createElement("span");
        ghost.dataset.terminalSuggestion = "";
        ghost.textContent = suggestion.slice(input.value.length);
        ink.append(ghost);
      }
      ink.style.transform = `translateX(${-input.scrollLeft}px)`;
    };

    const print = (line: Line, hang = 0) => {
      const row = document.createElement("p");

      if (hang) {
        row.style.paddingLeft = `${hang}ch`;
        row.style.textIndent = `-${hang}ch`;
      }

      for (const { text, href, command, tone, swatch, scheme } of line) {
        if (command) {
          const button = document.createElement("button");
          button.type = "button";
          button.dataset.terminalRun = command;
          button.textContent = text;
          row.append(button);
        } else if (href) {
          const link = document.createElement("a");
          link.href = href;
          link.textContent = text;
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          row.append(link);
        } else if (tone || swatch) {
          const span = document.createElement("span");
          span.textContent = text;
          if (tone) span.dataset.tone = tone;
          if (swatch) span.dataset.swatch = swatch;
          if (scheme) span.dataset.colors = scheme;
          row.append(span);
        } else {
          row.append(text);
        }
      }

      output.append(row);
    };

    const echo = (value: string, ok: boolean) => {
      const row = document.createElement("p");
      const prompt = document.createElement("span");

      prompt.textContent = "$";
      prompt.dataset.result = ok ? "success" : "error";
      row.className = "terminal-echo";
      row.append(prompt, ` ${value}`);
      output.append(row);
    };

    const scrollToEnd = () => {
      screen.scrollTop = screen.scrollHeight;
    };

    const setColors = (name: ColorScheme) => {
      dialog.dataset.colors = name;
      try {
        if (name === "default") localStorage.removeItem(COLORS_KEY);
        else localStorage.setItem(COLORS_KEY, name);
      } catch {}
    };

    const apply = (effect: Effect) => {
      switch (effect.type) {
        case "clear":
          output.replaceChildren();
          break;
        case "exit":
          dialog.close();
          break;
        case "scroll": {
          const section = document.getElementById(effect.target);
          const landing = section?.querySelector<HTMLElement>("h2") ?? section;
          const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

          focusOpenerOnClose = false;
          dialog.close();
          section?.scrollIntoView({
            behavior: reduceMotion ? "auto" : "smooth",
            block: "start",
          });

          if (landing) {
            landing.tabIndex = -1;
            landing.style.outline = "none";
            landing.focus({ preventScroll: true });
          }
          break;
        }
        case "open":
          window.open(effect.href, "_blank", "noopener,noreferrer");
          break;
        case "download": {
          const link = document.createElement("a");

          link.href = effect.href;
          link.download = "";
          dialog.append(link);
          link.click();
          link.remove();
          break;
        }
        case "theme":
          setTheme(effect.value);
          break;
        case "colors":
          setColors(effect.value);
          break;
        case "snow":
          setSnow(effect.value);
          break;
        case "lang":
          sessionStorage.setItem(REOPEN_KEY, "open");
          switchLang(effect.value);
          break;
      }
    };

    const execute = (value: string) => {
      const { lines, effect, hang, ok } = runCommand(value, content, {
        theme: getTheme(),
        snow: isSnowing(),
        colors: dialog.dataset.colors as ColorScheme,
      });

      echo(value, ok ?? (form.dataset.result !== "error"));
      recall.push(value);
      if (ok !== undefined) form.dataset.result = ok ? "success" : "error";
      updateTime();
      lines.forEach((line) => print(line, hang));
      input.value = "";
      syncInk();
      if (effect) apply(effect);
      scrollToEnd();
    };

    const open = () => {
      if (!dialog.open) dialog.showModal();

      if (!dialog.dataset.welcomed) {
        dialog.dataset.welcomed = "true";
        print(content.welcome);
      }

      updateTime();
      input.focus();
      syncInk();
      scrollToEnd();
    };

    openers.forEach((button) => button.addEventListener("click", open));

    closeButton.addEventListener("click", () => dialog.close());
    dialog.addEventListener("close", () => {
      if (focusOpenerOnClose) openers[0]?.focus({ preventScroll: true });
      focusOpenerOnClose = true;
      delete dialog.dataset.resumed;
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      execute(input.value);
    });

    output.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-terminal-run]");
      if (!button) return;

      execute(button.dataset.terminalRun!);
      if (dialog.open && !window.matchMedia("(hover: none)").matches) input.focus();
    });

    screen.addEventListener("click", (event) => {
      const onControl = (event.target as Element).closest("a, button, input");
      if (onControl || window.getSelection()?.toString()) return;

      input.focus();
    });

    input.addEventListener("input", syncInk);
    input.addEventListener("scroll", syncInk);
    input.addEventListener("keyup", syncInk);
    input.addEventListener("keydown", (event) => {
      if (event.isComposing || event.ctrlKey || event.metaKey || event.altKey) return;
      if (event.key === "ArrowRight" && !event.shiftKey && suggestion && input.selectionStart === input.value.length && input.selectionEnd === input.value.length) {
        event.preventDefault();
        input.value = suggestion;
        input.setSelectionRange(input.value.length, input.value.length);
        syncInk();
        return;
      }
      if (event.key === "ArrowUp" || event.key === "ArrowDown") {
        event.preventDefault();
        const value = event.key === "ArrowUp" ? recall.previous() : recall.next();
        if (value !== undefined) input.value = value;
        syncInk();
        return;
      }

      if (event.key !== "Tab" || event.shiftKey || !input.value.trim()) return;

      event.preventDefault();
      const { value, candidates } = complete(input.value);
      input.value = value;
      syncInk();

      if (candidates.length) {
        print([{ text: candidates.join("  ") }]);
        scrollToEnd();
      }
    });

    let storedColors: string | null = null;
    try { storedColors = localStorage.getItem(COLORS_KEY); } catch {}
    dialog.dataset.colors = colorSchemes.find((name) => name === storedColors) ?? "default";

    if (sessionStorage.getItem(REOPEN_KEY)) {
      sessionStorage.removeItem(REOPEN_KEY);
      dialog.dataset.resumed = "true";
      open();
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTerminalMode);
  } else {
    initTerminalMode();
  }

  document.addEventListener("astro:after-swap", initTerminalMode);
</script>

<style>
  .terminal-mode,
  .terminal-mode :global([data-colors="default"]) {
    --terminal-bg: #f8fafc;
    --terminal-bar-bg: #e2e8f0;
    --terminal-border: #cbd5e1;
    --terminal-surface: #e2e8f0;
    --terminal-text: #0f172a;
    --terminal-red: #b91c1c;
    --terminal-green: #0f766e;
    --terminal-yellow: #a16207;
    --terminal-blue: #1d4ed8;
    --terminal-magenta: #7e22ce;
    --terminal-cyan: #0e7490;
  }

  :global(.dark) .terminal-mode,
  :global(.dark) .terminal-mode :global([data-colors="default"]) {
    --terminal-bg: #020617;
    --terminal-bar-bg: #0f172a;
    --terminal-border: #475569;
    --terminal-surface: #1e293b;
    --terminal-text: #e2e8f0;
    --terminal-red: #f87171;
    --terminal-green: #4ade80;
    --terminal-yellow: #facc15;
    --terminal-blue: #60a5fa;
    --terminal-magenta: #c084fc;
    --terminal-cyan: #22d3ee;
  }

  .terminal-mode[data-colors="dracula"],
  .terminal-mode :global([data-colors="dracula"]) {
    --terminal-bg: #282a36;
    --terminal-bar-bg: #21222c;
    --terminal-border: #44475a;
    --terminal-surface: #44475a;
    --terminal-text: #f8f8f2;
    --terminal-red: #ff5555;
    --terminal-green: #50fa7b;
    --terminal-yellow: #f1fa8c;
    --terminal-blue: #bd93f9;
    --terminal-magenta: #ff79c6;
    --terminal-cyan: #8be9fd;
  }

  .terminal-mode[data-colors="gruvbox"],
  .terminal-mode :global([data-colors="gruvbox"]) {
    --terminal-bg: #282828;
    --terminal-bar-bg: #1d2021;
    --terminal-border: #504945;
    --terminal-surface: #3c3836;
    --terminal-text: #ebdbb2;
    --terminal-red: #fb4934;
    --terminal-green: #b8bb26;
    --terminal-yellow: #fabd2f;
    --terminal-blue: #83a598;
    --terminal-magenta: #d3869b;
    --terminal-cyan: #8ec07c;
  }

  .terminal-mode[data-colors="catppuccin"],
  .terminal-mode :global([data-colors="catppuccin"]) {
    --terminal-bg: #1e1e2e;
    --terminal-bar-bg: #181825;
    --terminal-border: #45475a;
    --terminal-surface: #313244;
    --terminal-text: #cdd6f4;
    --terminal-red: #f38ba8;
    --terminal-green: #a6e3a1;
    --terminal-yellow: #f9e2af;
    --terminal-blue: #89b4fa;
    --terminal-magenta: #cba6f7;
    --terminal-cyan: #94e2d5;
  }

  .terminal-mode[data-colors="tokyo-night"],
  .terminal-mode :global([data-colors="tokyo-night"]) {
    --terminal-bg: #1a1b26;
    --terminal-bar-bg: #16161e;
    --terminal-border: #414868;
    --terminal-surface: #292e42;
    --terminal-text: #c0caf5;
    --terminal-red: #f7768e;
    --terminal-green: #9ece6a;
    --terminal-yellow: #e0af68;
    --terminal-blue: #7aa2f7;
    --terminal-magenta: #bb9af7;
    --terminal-cyan: #7dcfff;
  }

  .terminal-mode {
    --terminal-muted: color-mix(in srgb, var(--terminal-text) 62%, var(--terminal-bg));

    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overscroll-behavior: contain;
    background: var(--terminal-bg);
    color: var(--terminal-text);
    font-family: var(--font-mono);
  }

  .terminal-mode[open] {
    display: flex;
    flex-direction: column;
    animation: terminal-in 0.16s ease-out;
  }

  .terminal-mode[data-resumed][open] {
    animation: none;
  }

  :global(html:has(.terminal-mode[open])) {
    overflow: hidden;
  }

  @keyframes terminal-in {
    from {
      opacity: 0;
      transform: translateY(0.4rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem clamp(1rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--terminal-border);
    background: var(--terminal-bar-bg);
    color: color-mix(in srgb, var(--terminal-text) 62%, var(--terminal-bar-bg));
    font-size: 0.8rem;
  }

  .terminal-bar strong {
    font-weight: 500;
  }

  .terminal-bar button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--terminal-border);
    border-radius: 0.4rem;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition:
      color 0.16s ease,
      border-color 0.16s ease;
  }

  .terminal-bar button:hover,
  .terminal-bar button:focus-visible {
    border-color: var(--terminal-green);
    color: var(--terminal-text);
  }

  .terminal-bar kbd {
    font: inherit;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .terminal-screen {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 1.1rem clamp(1rem, 3vw, 2.5rem) 2rem;
    background: var(--terminal-bg);
    font-size: 0.95rem;
    line-height: 1.6;
    cursor: text;
  }

  .terminal-output :global(p) {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .terminal-output :global(.terminal-echo) {
    margin-top: 0.7rem;
  }

  .terminal-output :global(.terminal-echo span) {
    color: var(--terminal-green);
  }

  .terminal-output :global(.terminal-echo [data-result="error"]) {
    color: var(--terminal-red);
  }

  .terminal-output :global(a) {
    color: var(--terminal-blue);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .terminal-output :global(button) {
    padding: 0;
    border: 0;
    background: none;
    color: var(--terminal-green);
    font: inherit;
    text-decoration: underline dotted;
    text-underline-offset: 0.22em;
    cursor: pointer;
  }

  .terminal-output :global([data-tone="accent"]),
  .terminal-output :global([data-tone="blue"]) {
    color: var(--terminal-blue);
  }
  .terminal-output :global([data-tone="red"]) {
    color: var(--terminal-red);
  }
  .terminal-output :global([data-tone="green"]) {
    color: var(--terminal-green);
  }
  .terminal-output :global([data-tone="yellow"]) {
    color: var(--terminal-yellow);
  }
  .terminal-output :global([data-tone="magenta"]) {
    color: var(--terminal-magenta);
  }
  .terminal-output :global([data-tone="cyan"]) {
    color: var(--terminal-cyan);
  }

  .terminal-output :global([data-tone="muted"]) {
    color: var(--terminal-muted);
  }

  .terminal-output :global([data-swatch]) {
    white-space: pre;
  }

  .terminal-output :global([data-swatch="red"]) {
    background: var(--terminal-red);
  }

  .terminal-output :global([data-swatch="green"]) {
    background: var(--terminal-green);
  }

  .terminal-output :global([data-swatch="yellow"]) {
    background: var(--terminal-yellow);
  }

  .terminal-output :global([data-swatch="blue"]) {
    background: var(--terminal-blue);
  }

  .terminal-output :global([data-swatch="magenta"]) {
    background: var(--terminal-magenta);
  }

  .terminal-output :global([data-swatch="cyan"]) {
    background: var(--terminal-cyan);
  }

  .terminal-prompt {
    --prompt-status: var(--terminal-green);
    margin-top: 1rem;
  }

  .terminal-prompt[data-result="error"] {
    --prompt-status: var(--terminal-red);
  }

  .terminal-prompt-top {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    font-size: inherit;
  }

  .terminal-directory {
    flex: none;
    color: var(--terminal-green);
  }

  .terminal-git {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    color: var(--terminal-magenta);
  }

  .terminal-on {
    flex: none;
    color: var(--terminal-muted);
  }

  .terminal-branch {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .terminal-commit {
    flex: none;
    color: var(--terminal-muted);
    white-space: nowrap;
  }

  .terminal-git svg {
    width: 0.9rem;
    height: 0.9rem;
    flex: none;
  }

  .terminal-prompt-top time {
    flex: none;
    margin-left: auto;
    color: var(--terminal-muted);
    font-size: 0.8rem;
  }

  .terminal-prompt-bottom {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-top: 0.35rem;
  }
  .terminal-prompt label {
    flex: none;
    color: var(--prompt-status);
  }
  .terminal-input-wrap {
    position: relative;
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }
  .terminal-highlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    white-space: pre;
    font: inherit;
  }
  .terminal-highlight :global([data-highlight="command"]) {
    color: var(--terminal-green);
  }
  .terminal-highlight :global([data-highlight="unknown"]) {
    color: var(--terminal-red);
  }
  .terminal-highlight :global([data-terminal-suggestion]) {
    color: var(--terminal-muted);
  }
  .terminal-prompt input {
    position: relative;
    display: block;
    width: 100%;
    min-width: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: transparent;
    font: inherit;
    line-height: inherit;
    caret-color: var(--terminal-text);
    outline: none;
  }
  .terminal-prompt input::selection {
    background: var(--terminal-surface);
    color: var(--terminal-text);
  }

  @media (max-width: 767px), (hover: none) {
    .terminal-screen {
      font-size: 0.85rem;
    }

    .terminal-input-wrap {
      font-size: 16px;
    }
  }

  @media (max-width: 479px) {
    .terminal-commit,
    .terminal-prompt-top time {
      display: none;
    }

    .terminal-prompt-top {
      gap: 0.5rem;
    }

    .terminal-git {
      gap: 0.3rem;
    }
  }

  @media (forced-colors: active) {
    .terminal-prompt input {
      color: CanvasText;
      caret-color: CanvasText;
    }

    .terminal-highlight {
      visibility: hidden;
    }
  }

  @media (hover: none) {
    .terminal-output :global(button) {
      margin-inline: -0.5rem;
      padding: 0.4rem 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-mode[open] {
      animation: none;
    }

    .terminal-bar button {
      transition: none;
    }
  }
</style>
