---
import { Icon } from "astro-icon/components";

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const label = lang === "pt-br" ? "Abrir modo terminal" : "Open terminal mode";
---

<button
  type="button"
  class="w-10 h-10 rounded-full bg-white/80 dark:bg-slate-800/80 backdrop-blur-sm border border-gray-200/50 dark:border-blue-500/30 hover:scale-105 active:scale-95 transition-transform duration-150 shadow-lg flex items-center justify-center cursor-pointer text-slate-600 dark:text-gray-200"
  aria-label={label}
  aria-haspopup="dialog"
  data-terminal-open
>
  <Icon name="mdi:console-line" class="h-5 w-5" aria-hidden="true" />
</button>

<style>
  @media (scripting: none) {
    button {
      display: none;
    }
  }
</style>
